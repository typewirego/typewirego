{
  "description": "Typewire conformance cases (design doc A1 rules P1-P10, A4). Each language's driver runs every case against its own typewire library. P11-P20 are native Go rules, met by the tests named in native_tests.json. Error classes are contractual; message text is not.",
  "languages": [
    "go",
    "python",
    "typescript"
  ],
  "rationales": [
    "introspection",
    "capability-absent",
    "python-narrowing-deferred",
    "q9-declined",
    "reference-bug"
  ],
  "ops": {
    "state": "A case owns one fresh container. Each define adds a wire under a case-local id; override replaces the wire held for an id with an override of it. Drivers count creator calls per id (the override's creator counts under '<id>.override') and log cleanups in the order they run.",
    "define": "id, label, creator; optional scope, imports, resolves, value, cleanup. Creates a wire with a new token labelled label (two defines never share a token, even with one label). id matches ^[a-z][a-z0-9_]*$ and is defined once. scope is singleton (default) or transient. imports lists ids defined earlier, resolved in order before the creator runs. creator: ok returns a fresh value, compared by identity, whose cleanup appends id to the cleanup log; fail raises; value returns the JSON value in value and has no cleanup. resolves lists ids the creator resolves through its resolver cutout when it runs, after its imports (Go: the Resolver argument; TypeScript: the resolution context; Python: the container's resolve). cleanup (only with creator ok) is ok (default) or fail: the cleanup still logs, then fails.",
    "override": "id, keep_imports. Replaces the wire for id with its override (with_creator / withCreator / WithCreator), keeping the token. The override's creator never calls the original and behaves as creator ok. keep_imports true keeps the original's imports declared (every language); false drops them (Python's one-argument with_creator only).",
    "apply": "ids. Applies the current wires for ids, in order, as one group.",
    "resolve": "id; optional expect_calls, expect_same_as, expect_error, expect_path. Resolves the current wire for id. expect_calls: the id's original creator has run this many times after the resolve. expect_same_as: the value is the same object as the last value resolved for that id. expect_path (only with expect_error cycle): the cycle's token labels from the first entry to the repeat.",
    "teardown": "Optional expect_error (only cleanup) and expect_failed (ids whose cleanups failed, in any order). Tears the container down.",
    "creator_calls": "expect: a map from id, or '<id>.override', to the creator calls so far. Only the listed keys are compared.",
    "cleanup_order": "expect: the full cleanup log so far, in order.",
    "graph": "expect_nodes, expect_edges. The container's graph after the ops so far. Nodes compare as a set, one per token: {id, label, scope, created, overridden}, where overridden means bound again after an override. Edges compare as a set: {from, to}, from the import to the importer, as in A2's DOT.",
    "expect_error": "cycle | not_registered | creator | closing | cleanup, matched against the error chain (Go: errors.Is through CreatorError and errors.Join): cycle is a circular dependency anywhere in the chain; not_registered a token never registered; closing a resolve on a container that has begun teardown; creator a creator failure, including a failed import; cleanup a teardown that returns cleanup errors.",
    "unknown": "A driver fails on an unknown op, an unknown key in an operation or case, or languages without a permitted rationale. Cases excluded from a language by languages are not executed there."
  },
  "cases": [
    {
      "name": "applying a wire registers its imports recursively",
      "rules": [
        "P1"
      ],
      "operations": [
        {
          "op": "define",
          "id": "leaf",
          "label": "t.Leaf",
          "creator": "ok"
        },
        {
          "op": "define",
          "id": "mid",
          "label": "t.Mid",
          "creator": "ok",
          "imports": [
            "leaf"
          ]
        },
        {
          "op": "define",
          "id": "top",
          "label": "t.Top",
          "creator": "ok",
          "imports": [
            "mid"
          ]
        },
        {
          "op": "apply",
          "ids": [
            "top"
          ]
        },
        {
          "op": "resolve",
          "id": "leaf",
          "expect_calls": 1
        },
        {
          "op": "resolve",
          "id": "mid",
          "expect_calls": 1
        },
        {
          "op": "creator_calls",
          "expect": {
            "leaf": 1,
            "mid": 1,
            "top": 0
          }
        }
      ]
    },
